# Copy to web/.env and fill in from:
#   Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup
#
# These values are not secrets. A Firebase web config is designed to ship in the
# browser bundle; access is controlled by firestore.rules, which Google enforces
# server-side, not by hiding these strings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. A reCAPTCHA v3 site key, once App Check is enabled — see SETUP.md.
VITE_RECAPTCHA_SITE_KEY=

# Optional. Maps use Esri's public World Imagery basemap without a key, which
# is fine to get going. An ArcGIS location platform key (free tier at
# developers.arcgis.com) switches to the supported production basemaps.
VITE_ARCGIS_API_KEY=

# Set to "true" to point the app at the local Firebase emulator suite.
VITE_USE_EMULATORS=false
