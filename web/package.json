{
  "name": "clock-in-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:ui": "node ui-smoke.mjs",
    "test:overtime": "node --experimental-strip-types overtime.test.mjs",
    "test:ticket": "node --experimental-strip-types --test ticket.test.mjs",
    "test:timecard": "node --experimental-strip-types --test timecard.test.mjs",
    "test:roster": "node --experimental-strip-types --test roster.test.mjs"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
