rules_version = '2';

// ---------------------------------------------------------------------------
// Coburn time clock — Firestore security rules
//
// There are no Cloud Functions. The app writes to Firestore directly and THESE
// RULES ARE THE ENTIRE ENFORCEMENT LAYER. Google evaluates them server-side, so
// a patched client, a scripted REST call or a rooted phone gets no further than
// the real app does.
//
// Runs on the free Spark plan: no Blaze, no Cloud Build, no service accounts.
//
// What is still genuinely enforced here:
//   - every timestamp is `request.time`, the server's clock, never the phone's
//   - the geofence is recomputed from the job site document on every punch
//   - a punch that is not verifiably on site MUST be marked for review; the
//     client cannot declare its own punch clean
//   - a shift, once written, is immutable apart from the exact transitions below
//   - roles come from the user document, not from anything the client sends
//   - a worker cannot open two shifts, edit their own hours, or touch anyone
//     else's record
//
// What cannot be done without a server, stated plainly rather than pretended:
//   - photo proof (that feature is off)
//   - disabling an Auth account. A deactivated worker can still sign in, but
//     every rule below denies them, so they can read and write nothing.
//   - a nightly sweep for forgotten shifts; an admin closes those by hand
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Identity -----------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Without Cloud Functions there are no custom claims to sign a role into,
    // so the role is read from the user document — which only an admin can
    // write, and which the client cannot forge.
    function isActive() {
      return hasProfile() && me().active == true;
    }

    function isAdmin() {
      return isActive() && me().role == 'admin';
    }

    // The owner is recorded on the company document, set when the company was
    // claimed. One level above a supervisor: supervisors run the yard, the
    // owner decides who the supervisors are.
    function ownerUid() {
      return get(/databases/$(database)/documents/config/company).data.ownerUid;
    }

    function isOwner() {
      return isActive() && request.auth.uid == ownerUid();
    }

    // --- Geometry -----------------------------------------------------------
    // Rules have no sqrt and no cos. So the fence is compared as SQUARED
    // distance against squared radius (no sqrt needed), and each job site
    // carries the metres-per-degree-of-longitude for its own latitude,
    // written by an admin when the site is created (no cos needed).

    // A fix gets the benefit of its own error bars, capped at 75 m so nobody
    // can claim a huge accuracy radius to "reach" a distant site.
    function slack(accuracy) {
      return accuracy < 75.0 ? accuracy : 75.0;
    }

    function withinFence(loc, site) {
      let dNorth = (loc.lat - site.lat) * 111320.0;
      let dEast = (loc.lng - site.lng) * site.metersPerDegLng;
      let allowed = site.radiusMeters + slack(loc.accuracy);
      return (dNorth * dNorth) + (dEast * dEast) <= (allowed * allowed);
    }

    function siteFor(jobSiteId) {
      return get(/databases/$(database)/documents/jobSites/$(jobSiteId)).data;
    }

    // --- Punch validation ---------------------------------------------------

    function locationSane(loc) {
      return loc.lat is number && loc.lat >= -90 && loc.lat <= 90
        && loc.lng is number && loc.lng >= -180 && loc.lng <= 180
        && loc.accuracy is number && loc.accuracy >= 0;
    }

    /**
     * A punch is verified only with a fresh, precise fix inside the fence.
     * Everything else has to be flagged — and because `needsReview` is required
     * to equal `!verified` below, the client cannot lie about which it is.
     */
    function punchVerified(p, site) {
      return p.method == 'gps'
        && p.location != null
        && locationSane(p.location)
        && p.location.accuracy <= 150
        && request.time < p.location.capturedAt + duration.value(2, 'm')
        && p.location.capturedAt < request.time + duration.value(1, 'm')
        && withinFence(p.location, site);
    }

    function punchWellFormed(p, jobSiteId) {
      return p.at == request.time
        && p.jobSiteId == jobSiteId
        && (p.method == 'gps' || p.method == 'unverified')
        && (p.location == null || locationSane(p.location));
    }

    // --- Company -----------------------------------------------------------
    // Creating this document is what claims the company. It can only be created
    // alongside its owner's admin profile, and only while it does not exist —
    // which is how "only the first person can make themselves an admin" is
    // expressed with no server to enforce it.

    match /config/company {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.role == 'admin';
      // Only the owner hands ownership on, and only to somebody who is already
      // an active supervisor — otherwise a mistyped id would leave the company
      // owned by nobody. Everything else on this document any supervisor may
      // change.
      allow update: if isAdmin()
        && (request.resource.data.ownerUid == resource.data.ownerUid
            || (isOwner()
                && get(/databases/$(database)/documents/users/$(request.resource.data.ownerUid))
                     .data.role == 'admin'
                && get(/databases/$(database)/documents/users/$(request.resource.data.ownerUid))
                     .data.active == true));
      allow delete: if false;
    }

    // --- Users --------------------------------------------------------------

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // The first administrator — only in the same batch that claims the
      // company, and only for yourself. Works exactly once, ever.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'admin'
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/config/company)
        && existsAfter(/databases/$(database)/documents/config/company);

      // Everyone after that is created by an administrator.
      allow create: if isAdmin()
        && request.resource.data.uid == uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.role in ['worker', 'admin'];

      // Admins edit anyone; the uid can never move, and the signature bound
      // applies to them too — this rule matches an admin editing their own
      // record, so leaving it off here would have made the cap below apply to
      // everybody except the people who actually store signatures.
      //
      // The owner's own record cannot be demoted or switched off by anybody,
      // themselves included. Ownership moves by handing it on, not by removing
      // the person holding it, and a company with no reachable owner is not a
      // state worth being able to reach.
      allow update: if isAdmin()
        && request.resource.data.uid == resource.data.uid
        && (uid != ownerUid()
            || (request.resource.data.role == 'admin'
                && request.resource.data.active == true))
        && (request.resource.data.get('signature', null) == null
            || (request.resource.data.signature.paths is list
                && request.resource.data.signature.paths.size() <= 400))
        && request.resource.data.updatedAt == request.time;

      // A worker may clear one flag on themselves — that they have changed
      // their temporary password. Nothing else, and never their own role.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['mustChangePassword', 'updatedAt'])
        && request.resource.data.mustChangePassword == false
        && request.resource.data.updatedAt == request.time;

      // And may store their own signature, so signing a ticket is one tap
      // rather than redrawing it daily. Its own rule rather than folded into
      // the one above, which would have forced a signature change to also
      // clear the temporary-password flag. Bounded like the ticket's copy.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['signature', 'updatedAt'])
        && (request.resource.data.get('signature', null) == null
            || (request.resource.data.signature.paths is list
                && request.resource.data.signature.paths.size() <= 400))
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // --- Job sites ----------------------------------------------------------

    match /jobSites/{siteId} {
      allow read: if isActive();

      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.radiusMeters is number
        && request.resource.data.radiusMeters >= 25
        && request.resource.data.radiusMeters <= 2000
        && request.resource.data.metersPerDegLng is number
        && request.resource.data.metersPerDegLng > 0
        && request.resource.data.updatedAt == request.time;

      // Retired by setting active:false, never removed — a shift pointing at a
      // deleted site is worse than one pointing at a stale site.
      allow delete: if false;
    }

    // --- Equipment ----------------------------------------------------------
    // The yard's machine list. Every active employee can read it, because the
    // clock screen has to offer the operator the machine they are climbing into.

    match /equipment/{equipmentId} {
      allow read: if isActive();

      allow create, update: if isAdmin()
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && request.resource.data.type.size() <= 60
        && request.resource.data.machineNo is string
        && request.resource.data.machineNo.size() <= 20
        && request.resource.data.active is bool
        && (request.resource.data.get('hourlyRate', null) == null
            || (request.resource.data.hourlyRate is number
                && request.resource.data.hourlyRate >= 0))
        && request.resource.data.updatedAt == request.time;

      // Retired with active:false. A ticket printed last year still names it.
      allow delete: if false;
    }

    // --- Daily rental tickets ----------------------------------------------
    // The document handed to the customer. Only a supervisor may touch one: it
    // is a billing record, and the hours on it are the hours being charged for.

    match /dailyTickets/{ticketId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.jobSiteId is string
        && request.resource.data.date is string
        // A signature is stroke paths, and it lives in this document because
        // there is no Cloud Storage. Bounded so nobody can push a ticket
        // towards Firestore's 1 MiB document limit and wedge the day's report.
        && (request.resource.data.get('signature', null) == null
            || (request.resource.data.signature.paths is list
                && request.resource.data.signature.paths.size() <= 400))
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // --- Clock state --------------------------------------------------------
    // One document per worker recording which shift is open. Rules cannot run a
    // query, so this single document is what makes "you cannot clock in twice"
    // and the rate limit enforceable.

    match /userState/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // The first punch of a worker's life creates this document, and may open a
      // shift in the same batch. There is deliberately no rate limit here:
      // nothing exists to rate-limit against, and requiring openShiftId to be
      // null on create would make that very first clock-in impossible.
      allow create: if isActive()
        && request.auth.uid == uid
        && request.resource.data.lastPunchAt == request.time
        && (request.resource.data.openShiftId == null
            || request.resource.data.openShiftId is string);

      // Opening a shift: only from nothing-open, naming a shift created in the
      // same batch, and no sooner than 30 seconds after the last punch.
      allow update: if isActive()
        && request.auth.uid == uid
        && resource.data.openShiftId == null
        && request.resource.data.openShiftId is string
        && request.resource.data.lastPunchAt == request.time
        && request.time > resource.data.lastPunchAt + duration.value(30, 's');

      // Closing: only the shift that is actually open.
      allow update: if isActive()
        && request.auth.uid == uid
        && resource.data.openShiftId is string
        && request.resource.data.openShiftId == null
        && request.resource.data.lastPunchAt == request.time
        && request.time > resource.data.lastPunchAt + duration.value(30, 's');

      // An admin clearing a stuck shift — the manual stand-in for the nightly
      // sweep that a scheduled function used to do.
      allow update: if isAdmin() && request.resource.data.openShiftId == null;

      allow delete: if false;
    }

    // --- Shifts -------------------------------------------------------------

    match /shifts/{shiftId} {
      // Rules are not filters: for a list query this is evaluated against every
      // document the query would return, so a worker querying their own uid
      // succeeds and any broader query — including an unfiltered read of the
      // collection — is rejected outright.
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      // Clocking in. The paired userState update in the same batch is what
      // proves no other shift was already open.
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.clockOut == null
        && request.resource.data.clockOutAt == null
        && request.resource.data.clockInAt == request.time
        && punchWellFormed(request.resource.data.clockIn, request.resource.data.jobSiteId)
        && siteFor(request.resource.data.jobSiteId).active == true
        // Asymmetric on purpose. Flagging a punch is ALWAYS allowed; claiming a
        // punch is clean is allowed only when it verifiably is. So the client
        // can never launder a bad punch, and a borderline fix — a metre outside
        // the fence, a GPS timestamp that ages out mid-request — falls back to
        // "recorded, needs review" instead of refusing the worker their hours.
        && (request.resource.data.needsReview == true
            || punchVerified(request.resource.data.clockIn,
                             siteFor(request.resource.data.jobSiteId)))
        && getAfter(/databases/$(database)/documents/userState/$(request.auth.uid))
             .data.openShiftId == shiftId;

      // Clocking out. Your own open shift, once, with the clock-in frozen.
      allow update: if isActive()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'open'
        && request.resource.data.status == 'closed'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.jobSiteId == resource.data.jobSiteId
        && request.resource.data.clockInAt == resource.data.clockInAt
        && request.resource.data.clockIn == resource.data.clockIn
        && request.resource.data.clockOutAt == request.time
        && punchWellFormed(request.resource.data.clockOut, resource.data.jobSiteId)
        // Same asymmetry as clock-in, plus: a shift already flagged at clock-in
        // can never be un-flagged by clocking out from inside the fence.
        && (request.resource.data.needsReview == true
            || (resource.data.needsReview == false
                && punchVerified(request.resource.data.clockOut,
                                 siteFor(resource.data.jobSiteId))))
        // Flags are evidence for the supervisor. Clocking out may add to them —
        // the second punch has its own problems — but never quietly drop the
        // ones the clock-in earned.
        //
        // Defaulted rather than read directly: a shift that was already open
        // when this rule shipped has no `flags` field at all, and reading a
        // missing field is an error that would strand that worker on the clock.
        && request.resource.data.get('flags', []).hasAll(resource.data.get('flags', []))
        && getAfter(/databases/$(database)/documents/userState/$(request.auth.uid))
             .data.openShiftId == null;

      // A worker asking for a correction. This only ever records the request —
      // the hours do not move until a supervisor approves, which is the whole
      // point of the feature.
      allow update: if isActive()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'closed'
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['pendingEdit', 'hasPendingEdit', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      // A supervisor ruling on a shift or correcting its times. The captured
      // evidence — where they were, on what, how far out — is never editable.
      allow update: if isAdmin()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.clockIn.location == resource.data.clockIn.location
        && request.resource.data.clockIn.device == resource.data.clockIn.device
        && request.resource.data.clockIn.distanceMeters == resource.data.clockIn.distanceMeters
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // --- Audit log ----------------------------------------------------------
    // Append-only and stamped with the server clock. Nobody can edit or delete
    // an entry, including whoever wrote it.

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isActive()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
